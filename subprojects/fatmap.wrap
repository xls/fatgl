# fatmap release package (prebuilt static library), MinGW-w64 x64.
# For development against a local fatmap, install it and point
# PKG_CONFIG_PATH at <prefix>/lib/pkgconfig: the dependency is found first.
[wrap-file]
directory = fatmap-0.4.0-windows-x64-mingw
source_url = https://github.com/xls/fatmap/releases/download/v0.4.0/fatmap-0.4.0-windows-x64-mingw.zip
source_filename = fatmap-0.4.0-windows-x64-mingw.zip
source_hash = 0b4ae072c77ec908bf1ceb216796e25a8c683e9bbaf6319dc4f4c92e003cc645
patch_directory = fatmap

[provide]
fatmap = fatmap_dep
